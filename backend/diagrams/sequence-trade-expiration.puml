@startuml Trade Expiration Scheduler

!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2

participant TradeExpirationScheduler
participant TradeCommandService
participant TradeRepository
participant TradeAuditLogRepository
participant CacheService
participant TradeEventProducer
database MySQL
database MongoDB
database Redis
queue Kafka

== Scheduled Task Triggered ==

TradeExpirationScheduler -> TradeCommandService: findAndExpireMaturedTrades()
activate TradeCommandService

TradeCommandService -> TradeRepository: findMaturedTrades()
activate TradeRepository
TradeRepository -> MySQL: SELECT WHERE maturityDate < TODAY\nAND expired = 'N'
MySQL --> TradeRepository: List<Trade>
TradeRepository --> TradeCommandService: List<Trade>
deactivate TradeRepository

loop For each matured trade
    TradeCommandService -> TradeCommandService: expireTrade(trade)
    activate TradeCommandService
    
    TradeCommandService -> TradeCommandService: Update trade:\n- expired = 'Y'\n- status = 'INACTIVE'
    activate TradeCommandService
    deactivate TradeCommandService
    
    TradeCommandService -> TradeRepository: save(trade)
    activate TradeRepository
    TradeRepository -> MySQL: UPDATE trade
    MySQL --> TradeRepository: Trade
    TradeRepository --> TradeCommandService: Trade
    deactivate TradeRepository
    
    TradeCommandService -> CacheService: setTrade(tradeId, version, tradeMap)
    activate CacheService
    CacheService -> Redis: UPDATE trade:{tradeId}:{version}
    Redis --> CacheService: OK
    deactivate CacheService
    
    TradeCommandService -> TradeCommandService: createAuditLog(TRADE_EXPIRED)
    activate TradeCommandService
    TradeCommandService -> TradeAuditLogRepository: save(auditLog)
    activate TradeAuditLogRepository
    TradeAuditLogRepository -> MongoDB: INSERT audit log\n(eventType=TRADE_EXPIRED)
    MongoDB --> TradeAuditLogRepository: TradeAuditLog
    TradeAuditLogRepository --> TradeCommandService: TradeAuditLog
    deactivate TradeAuditLogRepository
    deactivate TradeCommandService
    
    TradeCommandService -> TradeEventProducer: sendTradeEvent(TRADE_EXPIRED, ...)
    activate TradeEventProducer
    TradeEventProducer -> Kafka: PUBLISH to trade-reports topic
    Kafka --> TradeEventProducer: ACK
    deactivate TradeEventProducer
    
    deactivate TradeCommandService
end

TradeCommandService --> TradeExpirationScheduler: void
deactivate TradeCommandService

@enduml

