@startuml
title Trade Platform - Deployment Architecture

rectangle "Client Layer" {
  [Web Browser] as Browser
  [Mobile App] as Mobile
  [External API Client] as APIClient
}

rectangle "Gateway Layer" {
  [Gateway Service\nInstance 1] as Gateway1
  [Gateway Service\nInstance 2] as Gateway2
}

rectangle "Application Tier" {
  [Ingress Service\nInstance 1] as Ingress1
  [Ingress Service\nInstance 2] as Ingress2
  
  [Nginx Load Balancer] as Nginx
  
  [Trade Service\nInstance 1] as Trade1
  [Trade Service\nInstance 2] as Trade2
}

rectangle "AI Tier" {
  [AI Service\nInstance 1] as AI1
  [AI Service\nInstance 2] as AI2
}

rectangle "Infrastructure (Docker Containers)" {
  package "Database Cluster" {
    database "MySQL Primary" as MySQLPrimary
    database "MySQL Replica" as MySQLReplica
    database "MongoDB" as MongoDB
    database "Redis" as Redis
  }
  package "Message Queue" {
    node "Kafka Broker" as Kafka
    node "Zookeeper" as Zookeeper
  }

  package "AI Cluster" {
    database "ChromaDB" as ChromaDB
    node "Ollama LLM" as Ollama
  }
}

rectangle "Monitoring" {
  [Prometheus] as Prometheus
  [Grafana] as Grafana
}

Browser --> Gateway1 : HTTPS
Mobile --> Gateway1 : HTTPS

Gateway1 --> Ingress1 : HTTP
Gateway1 --> AI1 : HTTP
Gateway2 --> Ingress2 : HTTP
Gateway2 --> AI2 : HTTP

Ingress1 --> Nginx : HTTP
Ingress2 --> Nginx : HTTP

Nginx --> Trade1 : HTTP
Nginx --> Trade2 : HTTP

Trade1 --> MySQLPrimary
Trade1 --> MongoDB
Trade1 --> Redis
Trade1 --> Kafka

Trade2 --> MySQLPrimary
Trade2 --> Kafka

AI1 --> ChromaDB
AI1 --> Ollama
AI1 --> Kafka

AI2 --> ChromaDB
AI2 --> Ollama

Kafka --> Zookeeper
MySQLPrimary --> MySQLReplica

Gateway1 --> Prometheus
Trade1 --> Prometheus
Prometheus --> Grafana

@enduml

