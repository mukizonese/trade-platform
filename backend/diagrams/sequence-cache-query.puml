@startuml Cache Query

!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2

actor Client
participant GatewayService
participant IngressService
participant Nginx
participant CacheController
participant CacheService
database Redis

Client -> GatewayService: GET /api/trades/cache/{tradeId}
activate GatewayService

GatewayService -> IngressService: Route request
activate IngressService

IngressService -> Nginx: GET /api/trades/cache/{tradeId}
activate Nginx

Nginx -> CacheController: GET /api/trades/cache/{tradeId}
activate CacheController

CacheController -> CacheService: getTradesByTradeId(tradeId)
activate CacheService

CacheService -> Redis: KEYS trade:{tradeId}:*
Redis --> CacheService: Set<String> keys

loop For each key
    CacheService -> Redis: GET key
    Redis --> CacheService: String value (JSON)
    CacheService -> CacheService: Deserialize JSON to Map
end

CacheService -> CacheService: sortByLastUpdatedAtDescending()
activate CacheService
CacheService --> CacheService: List<Map<String, Object>>
deactivate CacheService

CacheService --> CacheController: List<Map<String, Object>>
deactivate CacheService

CacheController --> Nginx: List<Map<String, Object>>
deactivate CacheController

Nginx --> IngressService: List<Map<String, Object>>
deactivate Nginx

IngressService --> GatewayService: List<Map<String, Object>>
deactivate IngressService

GatewayService --> Client: 200 OK\nList<Map<String, Object>>
deactivate GatewayService

@enduml

