# Production Environment Configuration Template
# Copy this file to .env.docker-prod and configure with your production values

# AWS ECR Configuration
ECR_REPO_URL=851725258696.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPO_NAME=mukizone-repository
IMAGE_TAG=latest

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=docker-prod

# MySQL Configuration (Docker Compose)
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=trade_db
MYSQL_USERNAME=trade_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MongoDB Configuration (Docker Compose)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=trade_db
MONGO_USERNAME=trade_user
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis Configuration (Docker Compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_GUI=8001
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Zookeeper Configuration (Docker Compose)
ZOOKEEPER_PORT=2181

# Kafka Configuration (Docker Compose)
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29093
KAFKA_BOOTSTRAP_SERVERS=kafka:29093
KAFKA_TOPIC_TRADE_REPORTS=trade-reports

# Vector DB Configuration (Chroma)
VECTOR_DB_HOST=chroma
VECTOR_DB_PORT=8000
VECTOR_DB_COLLECTION=trade_reports

# Gateway
GATEWAY_PORT=8091
GATEWAY_TRADE_INGRESS_URL=http://trade-ingress-service:8092

# trade-ingress-trades
GATEWAY_PATH_TRADES=/api/trades

# trade-ingress-cache
GATEWAY_PATH_TRADES_CACHE=/api/trades/cache

# trade-ingress-audit
GATEWAY_PATH_AUDIT=/api/audit

# Ingress 
INGRESS_PORT=8092
TRADE_SERVICE_URL=http://trade-service:8093

API_PATH_TRADES=/api/trades
API_PATH_CACHE=/api/trades/cache
API_PATH_AUDIT=/api/audit

# Trade
TRADE_SERVICE_PORT=8093

CORS_ALLOWED_ORIGINS=

# Trade Expiration 
TRADE_EXPIRATION_CRON=

# Frontend Server
FRONTEND_PORT=3020
NEXT_PUBLIC_API_URL=https://trade.platform.mukizone.com

CORS_ALLOWED_ORIGINS=https://trade.platform.mukizone.com

SECURITY_ENFORCE_GATEWAY_ONLY=true
SECURITY_ALLOWED_IPS=
SECURITY_EXCLUDED_PATHS=/actuator/health,/actuator/info,/actuator/metrics

# Gateway Rate Limiter (Spring Cloud Gateway + Redis)
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20

# Ingress Service Rate Limiter (Resilience4j)
RATE_LIMIT_LIMIT_FOR_PERIOD=10
RATE_LIMIT_REFRESH_PERIOD=5s

